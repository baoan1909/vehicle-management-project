# Copy this file to .env on the staging host. Never commit the copied file.
# CI publishes BACKEND_IMAGE and FRONTEND_IMAGE with immutable tags such as
# ghcr.io/owner/repository/coparking-backend:<full-commit-sha>.
BACKEND_IMAGE=ghcr.io/replace-owner/vehicle-management-project/coparking-backend:sha-replace
FRONTEND_IMAGE=ghcr.io/replace-owner/vehicle-management-project/coparking-frontend:sha-replace
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=8088

# Application database. Use a dedicated least-privileged staging account.
DB_HOST=replace_with_staging_postgres_host
DB_PORT=5432
DB_NAME=vehicle_management_staging
DB_USERNAME=replace_with_staging_db_username
DB_PASSWORD=replace_with_staging_db_password
FLYWAY_DB_URL=jdbc:postgresql://replace_with_staging_postgres_host:5432/vehicle_management_staging
FLYWAY_DB_USERNAME=replace_with_staging_migration_username
FLYWAY_DB_PASSWORD=replace_with_staging_migration_password

# Identity provider and browser access. These are deployment-specific, not source code.
KEYCLOAK_ISSUER_URI=https://replace-with-keycloak-host/realms/vehicle-management
KEYCLOAK_BASE_URL=https://replace-with-keycloak-host
KEYCLOAK_REALM=vehicle-management
KEYCLOAK_FRONTEND_CLIENT_ID=vehicle-management-frontend
KEYCLOAK_ACTION_REDIRECT_URI=https://replace-with-frontend-host/login
KEYCLOAK_ADMIN_CLIENT_ID=vehicle-management-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=replace_with_keycloak_admin_client_secret
KEYCLOAK_AUDIENCE=vehicle-management-api
CORS_ALLOWED_ORIGINS=https://replace-with-frontend-host

# External infrastructure. Keep passwords/tokens only in the host environment
# file or a secret manager, never in this example.
RABBITMQ_HOST=replace_with_rabbitmq_host
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_USERNAME=replace_with_rabbitmq_username
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
REDIS_ENABLED=true
REDIS_HOST=replace_with_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password
MINIO_ENDPOINT=https://replace-with-minio-host
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_PUBLIC_BUCKET=vehicle-public
MINIO_PRIVATE_BUCKET=vehicle-private
OCR_ENABLED=false
OCR_BASE_URL=http://replace_with_ocr_host:8010
OCR_INTERNAL_TOKEN=replace_with_ocr_internal_token

# Optional integrations: leave disabled/empty until they are configured.
APP_MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
GEMINI_API_KEY=
AI_CACHE_KEY_HMAC_SECRET=replace_with_random_32byte_secret
