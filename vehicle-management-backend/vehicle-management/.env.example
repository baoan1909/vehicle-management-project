SERVER_PORT=8080
APP_TIME_ZONE=Asia/Ho_Chi_Minh

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vehicle_management_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true

KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/vehicle-management
KEYCLOAK_JWK_SET_URI=http://127.0.0.1:8081/realms/vehicle-management/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=vehicle-management-api
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=vehicle-management
KEYCLOAK_FRONTEND_CLIENT_ID=vehicle-management-frontend
KEYCLOAK_ACTION_REDIRECT_URI=http://localhost:5173/login
KEYCLOAK_ADMIN_CLIENT_ID=vehicle-management-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=replace_with_keycloak_admin_client_secret

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.6.1
KEYCLOAK_COMMAND=start-dev
KEYCLOAK_HOST_PORT=8081

KEYCLOAK_DB_IMAGE=postgres:16-alpine
KEYCLOAK_DB_HOST_PORT=5433
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=pass

KEYCLOAK_ADMIN_USERNAME=123
KEYCLOAK_ADMIN_PASSWORD=123

# Google OAuth credentials. Authorized redirect URI:
# http://localhost:8081/realms/vehicle-management/broker/google/endpoint
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_CLIENT_IMAGE=quay.io/minio/mc:latest
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_PUBLIC_BUCKET=vehicle-public
MINIO_PRIVATE_BUCKET=vehicle-private
MINIO_PRESIGNED_EXPIRE_SECONDS=900
MINIO_PUBLIC_URL_BASE=http://localhost:9000/vehicle-public
MINIO_IMAGE_MAX_SIZE_BYTES=5242880
MINIO_IMAGE_MAX_WIDTH_PIXELS=1280
MINIO_IMAGE_JPEG_QUALITY=0.85

RABBITMQ_IMAGE=rabbitmq:3.13-management
RABBITMQ_CONTAINER_NAME=vehicle-rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

APP_MAIL_ENABLED=true
APP_MAIL_FROM=vehiclemanagement.noreply@gmail.com
APP_MAIL_FROM_NAME=CoParking
APP_MAIL_PORTAL_URL=http://localhost:5173/login
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=vehiclemanagement.noreply@gmail.com
MAIL_PASSWORD=replace_with_gmail_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

OCR_IMAGE=ghcr.io/baoan1909/license-plate-recognition-yolov7-and-cnn-model:v5-candidate
OCR_CONTAINER_NAME=ocr-v5-candidate
OCR_HOST_PORT=8010
OCR_ENABLED=true
OCR_BASE_URL=http://localhost:8010
OCR_INTERNAL_TOKEN=replace_with_ocr_internal_token
OCR_MODEL_VERSION=detector-yolov7-v2-crnn-v5-grouped-hybrid
OCR_MODEL_STAGE=candidate
OCR_YOLO_WEIGHTS=/models/detector/best.pt
OCR_RECOGNIZER_BACKEND=crnn
OCR_CRNN_WEIGHTS=/models/recognizer/best.pt
OCR_CRNN_DECODER=plate_beam
OCR_CRNN_BEAM_WIDTH=8
OCR_REQUIRE_PRODUCTION_STAGE_FOR_AUTO_ACCEPT=true
OCR_IMAGE_SIZE=640
OCR_CONF_THRESHOLD=0.25
OCR_IOU_THRESHOLD=0.45
OCR_REVIEW_THRESHOLD=0.70
OCR_MAX_IMAGE_SIZE_BYTES=5242880
OCR_FORCE_CPU=true
OCR_ENABLE_CLAHE=true
OCR_ENABLE_SHARPEN=false
OCR_CONNECT_TIMEOUT_MS=1500
OCR_READ_TIMEOUT_MS=10000
OCR_CONFIDENCE_THRESHOLD=0.70

# Local ngrok container. Each developer should use a separate token and domain.
NGROK_IMAGE=ngrok/ngrok:latest
NGROK_CONTAINER_NAME=vehicle-ngrok
NGROK_AUTHTOKEN=replace_with_your_ngrok_authtoken
NGROK_DOMAIN=replace-with-your-domain.ngrok-free.dev
NGROK_INSPECTION_HOST_PORT=4040
BACKEND_HOST_PORT=8080

VNPAY_ENABLED=false
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_TMN_CODE=replace_with_vnpay_tmn_code
VNPAY_HASH_SECRET=replace_with_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Local development: VNPay redirects the user's browser back to this machine.
VNPAY_RETURN_URL=http://localhost:8080/vehicle-management/api/public/payments/vnpay/return
# Must use the same public domain configured in NGROK_DOMAIN.
VNPAY_IPN_URL=https://replace-with-your-domain.ngrok-free.dev/vehicle-management/api/public/payments/vnpay/ipn
VNPAY_FRONTEND_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_ORDER_TYPE=other
VNPAY_TIMEOUT_MINUTES=15
VNPAY_MINIMUM_AMOUNT=10000

AI_ASSISTANT_ENABLED=false
AI_GEMINI_DATA_MODE=UNPAID
AI_ALLOW_UNPAID_SUPPORT_DATA=false
AI_ASSISTANT_RECENT_MESSAGE_LIMIT=8
AI_ASSISTANT_MAX_ATTEMPTS=3
AI_ASSISTANT_RETRY_INITIAL_DELAY=20s
AI_ASSISTANT_REQUEST_TIMEOUT=20s
AI_ASSISTANT_PROMPT_VERSION=support-assistant-v1
AI_ASSISTANT_JOB_FIXED_DELAY_MS=2500
AI_ASSISTANT_JOB_INITIAL_DELAY_MS=5000
AI_MODEL_CATALOG_SYNC_FIXED_DELAY_MS=86400000
AI_MODEL_CATALOG_SYNC_INITIAL_DELAY_MS=60000

# Gemini/RAG ingestion and retrieval. Never commit a real API key.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_EMBEDDING_ENABLED=true
AI_INGESTION_ENABLED=true
AI_PGVECTOR_REQUIRED=true
AI_RETRIEVAL_UNACCENT_REQUIRED=true

# Redis optimization/resilience layer (never source of truth).
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=1s
REDIS_IMAGE=redis:7.4.1-alpine
REDIS_CONTAINER_NAME=vehicle-redis-cache
REDIS_HOST_PORT=6379
REDIS_MAXMEMORY=256mb
VEHICLE_NETWORK_NAME=vehicle-net
APP_ENV=local
APP_SERVICE_NAME=vehicle-management

AI_CACHE_ENABLED=true
AI_REDIS_QUERY_EMBEDDING_TTL=24h
AI_REDIS_PUBLIC_RETRIEVAL_TTL=15m
AI_REDIS_CUSTOMER_RETRIEVAL_TTL=10m
AI_REDIS_TENANT_RETRIEVAL_TTL=5m
AI_REDIS_NEGATIVE_RETRIEVAL_TTL=30s
AI_REDIS_PUBLIC_GROUNDED_ANSWER_TTL=15m
AI_REDIS_CUSTOMER_GROUNDED_ANSWER_TTL=5m
AI_REDIS_TENANT_GROUNDED_ANSWER_TTL=5m
AI_REDIS_SINGLE_FLIGHT_LOCK_TTL=45s
AI_SINGLE_FLIGHT_WAIT=2s

AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_FAILURE_WINDOW=120s
AI_CIRCUIT_BREAKER_OPEN_DURATION=60s
AI_CIRCUIT_BREAKER_MIN_OPEN_DURATION=30s
AI_CIRCUIT_BREAKER_MAX_OPEN_DURATION=300s
AI_CIRCUIT_BREAKER_HALF_OPEN_LOCK=30s

AI_MAX_MODELS_PER_JOB_ATTEMPT=3
AI_CACHE_TTL_JITTER_PERCENT=10
AI_CACHE_KEY_HMAC_SECRET=replace_with_random_32byte_secret_outside_source_code
