VITE_APP_NAME=Vehicle Management
VITE_API_BASE_URL=/vehicle-management/api
VITE_ASSET_BASE_URL=/assets
# Public SPA OIDC client. Never put a Keycloak client secret in Vite variables.
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/vehicle-management
VITE_OIDC_CLIENT_ID=vehicle-management-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/login
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_SCOPE=openid profile email roles
# Legacy compatibility fallback; new deployments should use the VITE_OIDC_* variables above.
VITE_KEYCLOAK_LOGIN_URL=http://localhost:8081/realms/vehicle-management/protocol/openid-connect/auth?client_id=vehicle-management-frontend&redirect_uri=http%3A%2F%2Flocalhost%3A5173%2Flogin&response_type=code&scope=openid%20profile%20email%20roles
