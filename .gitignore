# Never commit runtime environment files. Only the safe template is tracked.
**/.env
**/.env.*
!**/.env.example

# Keycloak runtime exports and private key material must never be committed.
**/keycloak/export/
*-users-*.json
*-realm-export.json
*.pem
*.key
*.p12
*.pfx
*.jks

# Local analysis and design artifacts at the repository root.
# Project-control and CI/CD guidance are intentional, versioned documentation.
/docs/*
!/docs/project-control/
!/docs/project-control/**
!/docs/ci-cd/
!/docs/ci-cd/**

# Local task output, interpreter caches and generated test/build files.
/.tmp/
**/__pycache__/
*.pyc
*.pyo
**/.pytest_cache/
**/.venv/
**/.vite/
**/coverage/
**/test-results/
**/playwright-report/
*.tsbuildinfo
*.log
hs_err_pid*
replay_pid*
*.hprof
*.dmp
.DS_Store
Thumbs.db
# Keep deliberate test evidence referenced by the handoff reports.
!**/docs/**/evidence/**/*.log
